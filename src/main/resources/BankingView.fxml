<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0" minWidth="900.0" prefHeight="720.0" prefWidth="1120.0" style="-fx-background-color: #F4F1EA;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="AccountController">
   <left>
      <VBox prefWidth="220.0" spacing="10.0" style="-fx-background-color: #1A2F24;" BorderPane.alignment="CENTER">
         <children>
            <Label text="BANKING SYSTEM" textFill="#D4AF37">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
            <Label text="Personal &amp; Business Banking" textFill="#A3B5AA">
               <font>
                  <Font name="System Italic" size="12.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="20.0" />
               </VBox.margin>
            </Label>
            <Label maxWidth="1.7976931348623157E308" style="-fx-background-color: #274333; -fx-alignment: BASELINE_LEFT; -fx-background-radius: 4; -fx-text-fill: white;" text="Dashboard">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
               <padding>
                  <Insets bottom="10.0" left="14.0" right="14.0" top="10.0" />
               </padding>
            </Label>
            <Region VBox.vgrow="ALWAYS" />
            <Separator opacity="0.15" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleLogout" style="-fx-background-color: transparent; -fx-alignment: BASELINE_LEFT;" text="Secure Log Out" textFill="#E57373">
               <padding>
                  <Insets bottom="10.0" left="14.0" right="14.0" top="10.0" />
               </padding>
            </Button>
         </children>
         <padding>
            <Insets bottom="20.0" left="18.0" right="18.0" top="24.0" />
         </padding>
      </VBox>
   </left>
   <center>
      <VBox spacing="18.0" BorderPane.alignment="CENTER">
         <children>
            <VBox spacing="2.0">
               <children>
                  <Label fx:id="welcomeLabel" text="Account Overview" textFill="#2C3430">
                     <font>
                        <Font name="System Bold" size="22.0" />
                     </font>
                  </Label>
                  <Label fx:id="accountNumberLabel" text="Select an account" textFill="#5C6661" />
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <ComboBox fx:id="accountComboBox" prefWidth="300.0" promptText="Select account" />
                        <Button mnemonicParsing="false" onAction="#handleOpenAccount" prefHeight="34.0" style="-fx-background-color: #1A2F24; -fx-background-radius: 4;" text="Open another account" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Button>
                     </children>
                  </HBox>
               </children>
            </VBox>
            <HBox spacing="16.0">
               <children>
                  <VBox prefWidth="220.0" spacing="4.0" style="-fx-background-color: #1A2F24; -fx-background-radius: 4;" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="TOTAL BALANCE" textFill="#D4AF37">
                           <font>
                              <Font name="System Bold" size="11.0" />
                           </font>
                        </Label>
                        <Label fx:id="balanceLabel" text="BWP 0.00" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="24.0" />
                           </font>
                        </Label>
                     </children>
                     <padding>
                        <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
                     </padding>
                  </VBox>
                  <VBox prefWidth="220.0" spacing="4.0" style="-fx-background-color: white; -fx-background-radius: 4; -fx-border-color: #D5D0C5; -fx-border-radius: 4;" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="ACCOUNT INFLOW" textFill="#5C6661">
                           <font>
                              <Font name="System Bold" size="11.0" />
                           </font>
                        </Label>
                        <Label fx:id="incomeLabel" text="BWP 0.00" textFill="#2E7D32">
                           <font>
                              <Font name="System Bold" size="22.0" />
                           </font>
                        </Label>
                     </children>
                     <padding>
                        <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
                     </padding>
                  </VBox>
                  <VBox prefWidth="220.0" spacing="4.0" style="-fx-background-color: white; -fx-background-radius: 4; -fx-border-color: #D5D0C5; -fx-border-radius: 4;" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="ACCOUNT OUTFLOW" textFill="#5C6661">
                           <font>
                              <Font name="System Bold" size="11.0" />
                           </font>
                        </Label>
                        <Label fx:id="expenseLabel" text="BWP 0.00" textFill="#C62828">
                           <font>
                              <Font name="System Bold" size="22.0" />
                           </font>
                        </Label>
                     </children>
                     <padding>
                        <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
                     </padding>
                  </VBox>
               </children>
            </HBox>
            <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 4; -fx-border-color: #D5D0C5; -fx-border-radius: 4;">
               <children>
                  <Label text="Record Transaction" textFill="#2C3430">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <children>
                        <ComboBox fx:id="typeComboBox" minWidth="110.0" prefHeight="36.0" prefWidth="145.0" promptText="Transaction type" />
                        <TextField fx:id="descriptionField" minWidth="130.0" prefHeight="36.0" promptText="Destination account for transfer" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="amountField" minWidth="120.0" prefHeight="36.0" prefWidth="150.0" promptText="Amount (BWP)" />
                        <Button mnemonicParsing="false" onAction="#handleTransaction" prefHeight="36.0" prefWidth="96.0" style="-fx-background-color: #1A2F24; -fx-background-radius: 4;" text="Submit" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#handleClearForm" prefHeight="36.0" prefWidth="70.0" style="-fx-background-color: #EAE8E3; -fx-background-radius: 4;" text="Clear" textFill="#2C3430" />
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
               </padding>
            </VBox>
            <VBox spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 4; -fx-border-color: #D5D0C5; -fx-border-radius: 4;" VBox.vgrow="ALWAYS">
               <children>
                  <Label text="Transaction Ledger" textFill="#2C3430">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <TableView fx:id="transactionTable" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colDate" prefWidth="120.0" text="Date" />
                        <TableColumn fx:id="colDescription" prefWidth="260.0" text="Description" />
                        <TableColumn fx:id="colType" prefWidth="120.0" text="Type" />
                        <TableColumn fx:id="colAmount" prefWidth="140.0" text="Amount (BWP)" />
                     </columns>
                  </TableView>
               </children>
               <padding>
                  <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
               </padding>
            </VBox>
         </children>
         <padding>
            <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>